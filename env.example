# ============================================================
# FY28 AOP Intake — Environment configuration template
# Copy to `.env` and fill in real values. No real secrets here.
# ============================================================

# --- Database (Postgres) — used ONLY for user accounts/auth ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# --- Auth secrets (generate: openssl rand -base64 32) ---
NEXTAUTH_SECRET=GENERATE_A_RANDOM_32_BYTE_SECRET
AUTH_SECRET=GENERATE_A_RANDOM_32_BYTE_SECRET

# --- Microsoft Entra ID (Azure AD) SSO — from your app registration ---
AUTH_MICROSOFT_ENTRA_ID_ID=YOUR_ENTRA_CLIENT_ID
AUTH_MICROSOFT_ENTRA_ID_SECRET=YOUR_ENTRA_CLIENT_SECRET
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0

# --- Admin access control (comma-separated emails) ---
ADMIN_EMAILS=admin1@yourorg.com,admin2@yourorg.com

# --- SharePoint list (source of truth for submissions) ---
SHAREPOINT_SITE_URL=https://YOURTENANT.sharepoint.com/sites/YOURSITE
SHAREPOINT_LIST_NAME=AOPFY28  IT Portfolio Planning
SHAREPOINT_SITE_ID=yourtenant.sharepoint.com,<site-guid>,<web-guid>
SHAREPOINT_LIST_ID=<list-guid>

# --- LLM API (transcript parser) — swap for your provider ---
ABACUSAI_API_KEY=YOUR_LLM_API_KEY

# NEXTAUTH_URL is set automatically at deploy time; set it locally only if needed.
# NEXTAUTH_URL=http://localhost:3000
